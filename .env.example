# Copie ce fichier en .env.local et remplis les deux valeurs (Supabase → Settings → API Keys).
# Ne mets jamais la clé « secret » ici : seule la clé « publishable » va dans le navigateur.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
